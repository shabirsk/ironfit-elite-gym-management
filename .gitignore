# ============================================
#  IRONFIT ELITE — .gitignore
# ============================================

# ========== Environment ==========
.env
.env.local
.env.production
.env.development
*.env.*

# ========== Dependencies ==========
node_modules/
backend/node_modules/

# ========== Build Output ==========
dist/
dist-ssr/
backend/dist/

# ========== Logs ==========
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
backend.log
server.log
vite.log

# ========== Editor & IDE ==========
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
*.swp
*.swo

# ========== OS ==========
Thumbs.db
ehthumbs.db
Desktop.ini

# ========== Testing ==========
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
coverage/
backend/coverage/

# ========== Python artifacts ==========
__pycache__/
*.pyc
*.pyo

# ========== Misc temporary files ==========
*.local
*.tmp
*.temp
.tmp/
.temp/
